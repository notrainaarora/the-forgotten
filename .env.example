# Copy to .env.local for local dev, and add the same values in Vercel → Project → Settings → Environment Variables.
# Without the Supabase values, the site runs in PREVIEW MODE with sample stories and forms that don't save.

# --- Required: Supabase → Project Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret! Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public address of the site (used in emails and sign-in links)
NEXT_PUBLIC_SITE_URL=https://theforgotten.site

# --- Recommended: email alerts via Resend (resend.com) ---
# New submissions → owners; confirmations → contributors (+ their guardian); "your story is live" emails.
RESEND_API_KEY=
EMAIL_FROM=The Forgotten <stories@theforgotten.site>
# Optional: send alerts here instead of to every owner (comma-separated)
NOTIFY_EMAIL=

# --- Recommended: spam protection via Cloudflare Turnstile (free) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
